; =====================================================================
; OpenIdentity Operation Wire Format v2
; File: spec/cddl/openidentity-operation-v2.cddl
; =====================================================================
;
; Normative encoding:
;   RFC 8949 Core Deterministic Encoding Requirements plus the
;   restrictions defined by docs/cryptographic-agility.md.
;
; CDDL defines structural validity. Semantic requirements such as
; canonical collection ordering, threshold evaluation, signature
; verification, state-transition validation, replay protection, and
; proof-of-possession are defined by the specification.
; =====================================================================

start = signed-operation

; =====================================================================
; Signed Operation
; =====================================================================
;
; 1 = operation
; 2 = authorization proofs
; 3 = controller proof-of-possession proofs (optional)
;
; No proof collection is included when calculating OperationBytes.
;
; CREATE normally omits field 3.
; ROTATE_CONTROLLER requires field 3 semantically and MUST provide
; exactly one valid controller proof for every VerificationMethod in
; the proposed new controller policy.
;
; SET_ASSERTION_POLICY with a non-nil proposed policy also requires
; field 3 and exactly one valid proof of possession for every proposed
; VerificationMethod. Removing the policy with nil does not.
; =====================================================================

signed-operation = {
    1 => operation,
    2 => [+ authorization-proof],
    ? 3 => [+ controller-proof]
}

; =====================================================================
; Operations
; =====================================================================
;
; Each valid operation type is structurally bound to its payload.
; RECOVER is allocated but intentionally absent until defined.
; =====================================================================

operation =
      create-operation
    / rotate-controller-operation
    / deactivate-operation
    / set-assertion-policy-operation

; =====================================================================
; Operation Type Registry
; =====================================================================
;
; 1 = CREATE
; 2 = ROTATE_CONTROLLER
; 3 = RECOVER (allocated, NOT valid in this schema)
; 4 = DEACTIVATE
; 5 = SET_ASSERTION_POLICY
;
; 6..23 reserved for future OpenIdentity core operations.
; =====================================================================

create-operation-type = 1
rotate-controller-operation-type = 2
recover-operation-type = 3
deactivate-operation-type = 4
set-assertion-policy-operation-type = 5

; =====================================================================
; CREATE
; =====================================================================
;
; Structurally enforced:
;   protocolVersion   = 1
;   operationType     = 1
;   sequence          = 1
;   previousStateHash = nil
; =====================================================================

create-operation = {
    1 => protocol-version,
    2 => create-operation-type,
    3 => identity-id,
    4 => create-sequence,
    5 => nil,
    6 => create-payload
}

create-sequence = 1

; 1 = controller policy
; 2 = recovery commitment (optional)

create-payload = {
    1 => controller-policy,
    ? 2 => recovery-commitment
}

; =====================================================================
; ROTATE_CONTROLLER
; =====================================================================
;
; Semantic requirements:
;   sequence = current authoritative sequence + 1
;   previousStateHash = hash of current canonical IdentityState
;
; The CURRENT controller policy authorizes the operation.
; Proposed new keys prove possession separately.
; =====================================================================

rotate-controller-operation = {
    1 => protocol-version,
    2 => rotate-controller-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => rotate-controller-payload
}

; 1 = proposed new controller policy
;
; Controller proof-of-possession evidence is deliberately NOT part of
; the operation payload because those proofs sign OperationBytes.
; Including them here would create a circular signing dependency.
;
; The proofs are carried in field 3 of signed-operation.

rotate-controller-payload = {
    1 => controller-policy
}

; =====================================================================
; DEACTIVATE
; =====================================================================

deactivate-operation = {
    1 => protocol-version,
    2 => deactivate-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => deactivate-payload
}

deactivate-payload = {}

; =====================================================================
; SET_ASSERTION_POLICY
; =====================================================================
;
; The CURRENT ControllerPolicy authorizes this operation.
; AssertionPolicy never authorizes changes to itself.
;
; Payload field 1 is a complete replacement AssertionPolicy, or nil to
; remove assertion authority.
;
; Applying this operation to IdentityState v1 explicitly upgrades the
; resulting state to IdentityState v2. Applying it to v2 keeps v2.
;
; A non-nil proposed policy requires proof of possession for every
; proposed VerificationMethod in signed-operation field 3.
; =====================================================================

set-assertion-policy-operation = {
    1 => protocol-version,
    2 => set-assertion-policy-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => set-assertion-policy-payload
}

set-assertion-policy-payload = {
    1 => assertion-policy / nil
}

; =====================================================================
; Protocol Version
; =====================================================================
;
; The signed operation envelope remains protocol version 1.
; IdentityState schema versioning is independent.
;
protocol-version = 1

; =====================================================================
; Shared Cryptographic Primitives
; =====================================================================
;
; identity-id, StateHash semantics, verification-method-id,
; openidentity-cose-key, signature, and policy encodings are reusable by
; other OpenIdentity specifications, including OI-003.
;
; Reuse of encodings does NOT transfer authorization semantics between
; ControllerPolicy and AssertionPolicy.
; =====================================================================

; =====================================================================
; Root Identity Identifier
; =====================================================================
;
; Exactly the raw 32 identifier bytes defined by OI-001.
; The textual did:open:z... representation MUST NOT appear in the
; canonical operation or canonical IdentityState.
; =====================================================================

identity-id = bstr .size 32

; =====================================================================
; Sequence
; =====================================================================

subsequent-sequence = 2..18446744073709551615

; =====================================================================
; Previous State Hash
; =====================================================================
;
; Contains one binary Multihash.
;
; OpenIdentity v0.1 producers MUST emit a SHA2-256 Multihash:
;
;   0x12 || 0x20 || SHA-256(StateBytes)
;
; resulting in exactly 34 bytes.
;
; The wider structural bound permits future supported Multihashes.
; A verifier MUST semantically validate the Multihash.
; =====================================================================

previous-state-hash = bstr .size (1..128)

; =====================================================================
; Recovery Commitment
; =====================================================================
;
; Opaque until the recovery specification defines its format.
; =====================================================================

recovery-commitment = bstr .size (1..128)

; =====================================================================
; Controller Policy
; =====================================================================

controller-policy =
      single-policy
    / threshold-policy

; AssertionPolicy deliberately reuses the same policy and
; VerificationMethod structures. Authorization purpose is distinct:
; ControllerPolicy authorizes IdentityState changes; AssertionPolicy
; authorizes cryptographic assertions made on behalf of the identity at
; this exact IdentityState.
;
; Assertion authority is intentionally format-agnostic. OI-003 credentials
; are one consumer of this authority; future OpenIdentity assertion formats
; MAY reuse the same state-level authorization relationship.
;
; Membership in either policy MUST NOT imply membership in the other.
assertion-policy =
      single-policy
    / threshold-policy

; ---------------------------------------------------------------------
; SINGLE
;
; 1 = policy type = 1
; 2 = exactly one VerificationMethod
; ---------------------------------------------------------------------

single-policy = {
    1 => single-policy-type,
    2 => [ verification-method ]
}

single-policy-type = 1

; ---------------------------------------------------------------------
; THRESHOLD
;
; 1 = policy type = 2
; 2 = threshold
; 3 = VerificationMethods
;
; Semantic invariant:
;   1 <= threshold <= number of VerificationMethods
; ---------------------------------------------------------------------

threshold-policy = {
    1 => threshold-policy-type,
    2 => threshold,
    3 => [+ verification-method]
}

threshold-policy-type = 2
threshold = 1..65535

; =====================================================================
; Verification Method
; =====================================================================
;
; 1 = 16-byte Verification Method ID
; 2 = COSE_Key
; =====================================================================

verification-method = {
    1 => verification-method-id,
    2 => openidentity-cose-key
}

verification-method-id = bstr .size 16

; =====================================================================
; OpenIdentity COSE Keys
; =====================================================================

openidentity-cose-key =
      ed25519-cose-key
    / ml-dsa-65-cose-key

; ---------------------------------------------------------------------
; Ed25519 COSE_Key
;
;  1 = kty = 1  (OKP)
;  3 = alg = -8 (EdDSA)
; -1 = crv = 6  (Ed25519)
; -2 = x = 32-byte public key
; ---------------------------------------------------------------------

ed25519-cose-key = {
     1 => ed25519-kty,
     3 => ed25519-alg,
    -1 => ed25519-curve,
    -2 => ed25519-public-key
}

ed25519-kty = 1
ed25519-alg = -8
ed25519-curve = 6
ed25519-public-key = bstr .size 32

; ---------------------------------------------------------------------
; ML-DSA-65 COSE_Key
;
;  1 = kty = 7   (AKP)
;  3 = alg = -49 (ML-DSA-65)
; -1 = pub = 1952-byte raw public key
; ---------------------------------------------------------------------

ml-dsa-65-cose-key = {
     1 => ml-dsa-kty,
     3 => ml-dsa-65-alg,
    -1 => ml-dsa-65-public-key
}

ml-dsa-kty = 7
ml-dsa-65-alg = -49
ml-dsa-65-public-key = bstr .size 1952

; =====================================================================
; Authorization Proof
; =====================================================================
;
; 1 = Verification Method ID
; 2 = raw algorithm-specific signature bytes
; =====================================================================

authorization-proof = {
    1 => verification-method-id,
    2 => signature
}

; =====================================================================
; Controller Proof of Possession
; =====================================================================

controller-proof = {
    1 => verification-method-id,
    2 => signature
}

; =====================================================================
; Signature
; =====================================================================
;
; v0.1 semantic sizes:
;   Ed25519   = 64 bytes
;   ML-DSA-65 = 3309 bytes
; =====================================================================

signature = bstr .size (1..65535)

; =====================================================================
; Canonical Identity State
; =====================================================================
;
; v1 remains frozen. v2 adds optional AssertionPolicy at map label 7.
; =====================================================================

identity-state =
      identity-state-v1
    / identity-state-v2

; Canonical Identity State v1 -- frozen
identity-state-v1 = {
    1 => identity-state-version-v1,
    2 => identity-id,
    3 => state-sequence,
    4 => identity-status,
    5 => controller-policy,
    ? 6 => recovery-commitment
}

; Canonical Identity State v2
;
; 1 = state version = 2
; 2 = identity
; 3 = sequence
; 4 = status
; 5 = controller policy
; 6 = recovery commitment (optional)
; 7 = assertion policy (optional)
;
; Absence of field 7 means NO assertion authority. It MUST NOT imply
; fallback to ControllerPolicy.
identity-state-v2 = {
    1 => identity-state-version-v2,
    2 => identity-id,
    3 => state-sequence,
    4 => identity-status,
    5 => controller-policy,
    ? 6 => recovery-commitment,
    ? 7 => assertion-policy
}

identity-state-version-v1 = 1
identity-state-version-v2 = 2
state-sequence = 1..18446744073709551615

; ---------------------------------------------------------------------
; Identity Status
;
; 1 = ACTIVE
; 2 = DEACTIVATED
; ---------------------------------------------------------------------

identity-status =
      active-status
    / deactivated-status

active-status = 1
deactivated-status = 2

; =====================================================================
; State Hash
; =====================================================================
;
; OpenIdentity state hash calculation for both v1 and v2:
;
;   StateBytes =
;       deterministicCBOR(identity-state)
;
;   digest =
;       SHA-256(StateBytes)
;
;   StateHash =
;       0x12 || 0x20 || digest
;
; where:
;   0x12 = Multihash SHA2-256 code
;   0x20 = 32-byte digest length
;
; StateHash is therefore 34 bytes for the v0.1 SHA2-256 profile.
;
; A subsequent operation places StateHash into previousStateHash.
; =====================================================================

; =====================================================================
; Authorization Signing Structure
; =====================================================================
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Operation",
;   1,
;   operationBytes
; ]
; =====================================================================

operation-signing-structure = [
    "OpenIdentity Operation",
    signing-structure-version,
    operation-bytes
]

; =====================================================================
; Controller Proof-of-Possession Signing Structure
; =====================================================================
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Controller Proof",
;   1,
;   operationBytes,
;   verificationMethodId
; ]
; =====================================================================

controller-proof-signing-structure = [
    "OpenIdentity Controller Proof",
    signing-structure-version,
    operation-bytes,
    verification-method-id
]

signing-structure-version = 1

; =====================================================================
; Operation Bytes
; =====================================================================
;
; Complete deterministic RFC 8949 CBOR encoding of exactly one valid
; OpenIdentity Operation. It excludes authorization proofs and
; transport metadata.
; =====================================================================

operation-bytes = bstr

; =====================================================================
; Canonical Ordering Requirements
; =====================================================================
;
; VerificationMethods within every ControllerPolicy and AssertionPolicy
; MUST be sorted by Verification Method ID using unsigned bytewise
; lexicographic ordering.
;
; The same VerificationMethod MAY appear in both policies only when
; explicitly present in both. Membership never transfers implicitly.
;
; Authorization proofs and controller proofs MUST use the same ordering.
;
; Duplicate Verification Method IDs MUST be rejected within each
; relevant collection.
; =====================================================================

; =====================================================================
; Deterministic CBOR Requirements
; =====================================================================
;
; Every cryptographically authoritative structure MUST use RFC 8949
; Core Deterministic Encoding Requirements.
;
; OpenIdentity v0.1 additionally requires:
;
; - definite-length byte/text strings, arrays, and maps
; - preferred integer serialization
; - deterministic map-key ordering
; - rejection of duplicate map keys
; - rejection of unknown OpenIdentity-defined map labels
; - no floating-point values
; - no NaN or Infinity
; - no undefined
; - no arbitrary CBOR tags
; - no unassigned simple values
;
; Negative integers are permitted where explicitly required by
; standardized COSE structures and identifiers.
; =====================================================================

; =====================================================================
; CREATE State Transition
; =====================================================================
;
; A valid CREATE remains unchanged and produces IdentityState v1:
;
; {
;   1: 1,                    stateVersion
;   2: identity,
;   3: 1,                    sequence
;   4: 1,                    ACTIVE
;   5: controllerPolicy,
;   6: recoveryCommitment?   if supplied by CREATE
; }
;
; The resulting deterministic CBOR bytes are StateBytes.
; =====================================================================

; =====================================================================
; ROTATE_CONTROLLER State Transition
; =====================================================================
;
; A valid ROTATE_CONTROLLER:
;
; - MUST use previousStateHash equal to the StateHash of the current
;   authoritative IdentityState
; - MUST use sequence = current state sequence + 1
; - MUST be authorized by the CURRENT controller policy
; - MUST include, in signed-operation field 3, valid proof of possession
;   for every proposed new VerificationMethod
;
; Applying it produces a new ACTIVE IdentityState containing the new
; controller policy and incremented sequence.
; =====================================================================

; =====================================================================
; DEACTIVATE State Transition
; =====================================================================
;
; A valid DEACTIVATE uses the current StateHash as previousStateHash
; and produces an IdentityState whose status is DEACTIVATED.
;
; Final permanence and recovery semantics are defined separately.
; =====================================================================

; =====================================================================
; SET_ASSERTION_POLICY State Transition
; =====================================================================
;
; Preconditions:
; - identity matches current authoritative state
; - sequence = current sequence + 1
; - previousStateHash = StateHash(current IdentityState)
; - CURRENT ControllerPolicy authorizes the operation
;
; For non-nil policies:
; - policy MUST be structurally and semantically valid
; - VerificationMethods MUST be canonically ordered
; - duplicate method IDs MUST be rejected
; - signed-operation field 3 MUST contain exactly one valid proof of
;   possession for every proposed VerificationMethod
;
; v1 + SET_ASSERTION_POLICY => v2.
; v2 + SET_ASSERTION_POLICY => v2.
; A non-nil value atomically replaces AssertionPolicy.
; nil removes AssertionPolicy and means no assertion authority.
; AssertionPolicy MUST NOT authorize changes to itself.
;
; Existing identity, status, ControllerPolicy, and recovery commitment
; are preserved; sequence increments.
; =====================================================================

; =====================================================================
; v2 Preservation and Downgrade Rules
; =====================================================================
;
; ROTATE_CONTROLLER:
; - v1 -> v1
; - v2 -> v2
; - when v2, AssertionPolicy MUST be preserved unchanged
;
; DEACTIVATE:
; - v1 -> v1
; - v2 -> v2
; - when v2, AssertionPolicy remains part of canonical historical state
;
; v2 -> v1 is forbidden.
;
; Unsupported future IdentityState versions MUST be rejected rather than
; interpreted as v1/v2 while ignoring unknown fields.
; =====================================================================

; =====================================================================
; Assertion Authority and Historical State
; =====================================================================
;
; AssertionPolicy is the sole canonical source of cryptographic assertion
; authority for an OpenIdentity identity at a particular IdentityState.
; It projects to the W3C assertionMethod verification relationship.
;
; ControllerPolicy membership MUST NOT imply assertion authority.
; AssertionPolicy membership MUST NOT imply controller authority.
;
; StateHash commits to the complete IdentityState, including state
; version and AssertionPolicy when present. OI-003 uses StateHash as the
; cryptographic historical-state identifier. The did:open resolution
; profile exposes that identifier using DID Resolution versionId.
;
; Current projections expose only current assertion authority.
; Consumers requiring historical authorization MUST evaluate AssertionPolicy
; from the exact historical authoritative state bound by StateHash/versionId.
; They MUST NOT substitute the current IdentityState.
;
; Removal or replacement changes current authority but does not rewrite
; historical IdentityStates. Acceptance, status, and revocation of earlier
; assertions are defined by the consuming assertion protocol.
; =====================================================================

; =====================================================================
; RECOVER Reservation
; =====================================================================
;
; Operation code 3 is allocated to RECOVER but intentionally absent
; from the `operation` choice.
;
; A conforming implementation of this schema MUST reject operationType 3
; until recovery payload, policy, threshold, timing, cryptographic
; diversity, and authorization semantics are normatively defined.
; =====================================================================

; =====================================================================
; End OpenIdentity Operation Wire Format v2
; =====================================================================
