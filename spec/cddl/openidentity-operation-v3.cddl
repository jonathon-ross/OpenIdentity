; =====================================================================
; OpenIdentity Operation Wire Format v3
; File: spec/cddl/openidentity-operation-v3.cddl
; =====================================================================
;
; Normative encoding:
;   RFC 8949 Core Deterministic Encoding Requirements plus the
;   restrictions defined by docs/cryptographic-agility.md.
;
; CDDL defines structural validity. Semantic requirements such as
; canonical collection ordering, threshold evaluation, signature
; verification, state-transition validation, replay protection, and
; proof-of-possession are defined by the specification.
; =====================================================================

start = signed-operation-v3

; =====================================================================
; Signed Operation
; =====================================================================
;
; Proof collections are excluded from OperationBytes. The envelope is an
; operation-specific union so proof collections that cannot apply to an
; operation are structurally forbidden.
;
; Field 2 = current/proposed ControllerPolicy authorization
; Field 3 = replacement ControllerPolicy proof of possession
; Field 4 = RecoveryPolicy authorization
; Field 5 = AuthenticationPolicy proof of possession
; Field 6 = AssertionPolicy proof of possession
; Field 7 = DelegationPolicy proof of possession
; =====================================================================

signed-operation-v3 =
      signed-create
    / signed-rotate-controller
    / signed-recover
    / signed-deactivate
    / signed-set-assertion-policy
    / signed-set-authentication-policy
    / signed-set-delegation-policy
    / signed-reset-authentication
    / signed-reset-delegations

signed-create = {
    1 => create-operation,
    2 => [+ authorization-proof],
    ? 5 => [+ authentication-proof],
    ? 6 => [+ assertion-proof],
    ? 7 => [+ delegation-proof]
}

signed-rotate-controller = {
    1 => rotate-controller-operation,
    2 => [+ authorization-proof],
    3 => [+ controller-proof]
}

signed-recover = {
    1 => recover-operation,
    3 => [+ controller-proof],
    4 => [+ recovery-proof],
    ? 6 => [+ assertion-proof]
}

signed-deactivate = {
    1 => deactivate-operation,
    2 => [+ authorization-proof]
}

signed-set-assertion-policy = {
    1 => set-assertion-policy-operation,
    2 => [+ authorization-proof],
    ? 6 => [+ assertion-proof]
}

signed-set-authentication-policy = {
    1 => set-authentication-policy-operation,
    2 => [+ authorization-proof],
    ? 5 => [+ authentication-proof]
}

signed-set-delegation-policy = {
    1 => set-delegation-policy-operation,
    2 => [+ authorization-proof],
    ? 7 => [+ delegation-proof]
}

signed-reset-authentication = {
    1 => reset-authentication-operation,
    2 => [+ authorization-proof]
}

signed-reset-delegations = {
    1 => reset-delegations-operation,
    2 => [+ authorization-proof]
}

; =====================================================================
; Operations
; =====================================================================
;
; Each valid operation type is structurally bound to its payload.
; RECOVER is defined by OI-007.
; =====================================================================

operation-v3 =
      create-operation
    / rotate-controller-operation
    / recover-operation
    / deactivate-operation
    / set-assertion-policy-operation
    / set-authentication-policy-operation
    / set-delegation-policy-operation
    / reset-authentication-operation
    / reset-delegations-operation

; =====================================================================
; Operation Type Registry
; =====================================================================
;
; 1 = CREATE
; 2 = ROTATE_CONTROLLER
; 3 = RECOVER
; 4 = DEACTIVATE
; 5 = SET_ASSERTION_POLICY
;
; 6 = SET_AUTHENTICATION_POLICY
; 7 = SET_DELEGATION_POLICY
; 8 = RESET_AUTHENTICATION
; 9 = RESET_DELEGATIONS
; 10..23 reserved for future OpenIdentity core operations.
; =====================================================================

create-operation-type = 1
rotate-controller-operation-type = 2
recover-operation-type = 3
deactivate-operation-type = 4
set-assertion-policy-operation-type = 5
set-authentication-policy-operation-type = 6
set-delegation-policy-operation-type = 7
reset-authentication-operation-type = 8
reset-delegations-operation-type = 9

; =====================================================================
; CREATE
; =====================================================================
;
; Structurally enforced:
;   protocolVersion   = 2
;   operationType     = 1
;   sequence          = 1
;   previousStateHash = nil
; =====================================================================

create-operation = {
    1 => protocol-version,
    2 => create-operation-type,
    3 => identity-id,
    4 => create-sequence,
    5 => nil,
    6 => create-payload
}

create-sequence = 1

; 1 = controller policy
; 2 = recovery commitment (optional)

create-payload = {
    1 => controller-policy,
    ? 2 => recovery-commitment,
    ? 3 => assertion-policy,
    ? 4 => authentication-policy,
    ? 5 => delegation-policy
}

; =====================================================================
; ROTATE_CONTROLLER
; =====================================================================
;
; Semantic requirements:
;   sequence = current authoritative sequence + 1
;   previousStateHash = hash of current canonical IdentityState
;
; The CURRENT controller policy authorizes the operation.
; Proposed new keys prove possession separately.
; =====================================================================

rotate-controller-operation = {
    1 => protocol-version,
    2 => rotate-controller-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => rotate-controller-payload
}

; 1 = proposed new controller policy
;
; Controller proof-of-possession evidence is deliberately NOT part of
; the operation payload because those proofs sign OperationBytes.
; Including them here would create a circular signing dependency.
;
; The proofs are carried in field 3 of signed-operation.

rotate-controller-payload = {
    1 => controller-policy
}

; =====================================================================
; RECOVER
; =====================================================================
;
; RECOVER is authorized exclusively by the RecoveryPolicy committed to by
; the current authoritative IdentityState. Ordinary ControllerPolicy
; authorization MUST NOT be required.
;
; Payload:
;   1 = complete new ControllerPolicy
;   2 = revealed current RecoveryPolicy
;   3 = new recoveryCommitment
;
; Semantics:
; - identity matches current state
; - sequence = current sequence + 1
; - previousStateHash = StateHash(current state)
; - revealed RecoveryPolicy hashes to current recoveryCommitment
; - field 4 recovery proofs satisfy the revealed RecoveryPolicy
; - field 3 contains exactly one valid controller PoP for every method in
;   the new ControllerPolicy
; =====================================================================

recover-operation = {
    1 => protocol-version,
    2 => recover-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => recover-payload
}

recover-payload =
      recover-preserve-assertion-payload
    / recover-remove-assertion-payload
    / recover-replace-assertion-payload

recover-preserve-assertion-payload = {
    1 => controller-policy,
    2 => recovery-policy,
    3 => recovery-commitment,
    4 => 1
}

recover-remove-assertion-payload = {
    1 => controller-policy,
    2 => recovery-policy,
    3 => recovery-commitment,
    4 => 2
}

recover-replace-assertion-payload = {
    1 => controller-policy,
    2 => recovery-policy,
    3 => recovery-commitment,
    4 => 3,
    5 => assertion-policy
}


; =====================================================================
; DEACTIVATE
; =====================================================================

deactivate-operation = {
    1 => protocol-version,
    2 => deactivate-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => deactivate-payload
}

deactivate-payload = {}

; =====================================================================
; SET_ASSERTION_POLICY
; =====================================================================
;
; The CURRENT ControllerPolicy authorizes this operation.
; AssertionPolicy never authorizes changes to itself.
;
; Payload field 1 is a complete replacement AssertionPolicy, or nil to
; remove assertion authority.
;
; ProtocolVersion 2 successful application always produces IdentityState v3.
;
; A non-nil proposed policy requires proof of possession for every
; proposed VerificationMethod in signed-operation field 6.
; =====================================================================

set-assertion-policy-operation = {
    1 => protocol-version,
    2 => set-assertion-policy-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => set-assertion-policy-payload
}

set-assertion-policy-payload = {
    1 => assertion-policy / nil
}

; =====================================================================
; Protocol v2 derived-authority operations
; =====================================================================

authority-disposition = 1 / 2
; 1 = INVALIDATE_EXISTING
; 2 = PRESERVE_EXISTING

set-authentication-policy-operation = {
    1 => protocol-version,
    2 => set-authentication-policy-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => set-authentication-policy-payload
}
set-authentication-policy-payload = {
    1 => authentication-policy / nil,
    ? 2 => authority-disposition
}

set-delegation-policy-operation = {
    1 => protocol-version,
    2 => set-delegation-policy-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => set-delegation-policy-payload
}
set-delegation-policy-payload = {
    1 => delegation-policy / nil,
    ? 2 => authority-disposition
}

reset-authentication-operation = {
    1 => protocol-version,
    2 => reset-authentication-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => {}
}

reset-delegations-operation = {
    1 => protocol-version,
    2 => reset-delegations-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => {}
}

authentication-proof = { 1 => verification-method-id, 2 => signature }
assertion-proof = { 1 => verification-method-id, 2 => signature }
delegation-proof = { 1 => verification-method-id, 2 => signature }

authentication-proof-signing-structure = [
    "OpenIdentity Authentication Proof", signing-structure-version,
    operation-bytes, verification-method-id
]
assertion-proof-signing-structure = [
    "OpenIdentity Assertion Proof", signing-structure-version,
    operation-bytes, verification-method-id
]
delegation-proof-signing-structure = [
    "OpenIdentity Delegation Proof", signing-structure-version,
    operation-bytes, verification-method-id
]

; =====================================================================
; Protocol Version
; =====================================================================
;
; ProtocolVersion 2 is the explicit IdentityState-v3 upgrade boundary.
; Successful protocolVersion 2 state-changing operations produce stateVersion 3.
; ProtocolVersion 1 operations MUST NOT be applied to IdentityState v3.
;
protocol-version = 2

; =====================================================================
; Root Identity Identifier
; =====================================================================
;
; Exactly the raw 32 identifier bytes defined by OI-001.
; The textual did:open:z... representation MUST NOT appear in the
; canonical operation or canonical IdentityState.
; =====================================================================

identity-id = bstr .size 32

; =====================================================================
; Sequence
; =====================================================================
;
; Sequence state-machine semantics are defined by OI-008.
;
; CREATE uses sequence 1. Every authoritative state-changing operation
; after CREATE MUST use:
;
;   sequence = current authoritative sequence + 1
;
; Sequence MUST NOT decrease, reset, skip, or wrap.
; The uint64 bound below is the protocol-v0.1 wire representation.
; =====================================================================

subsequent-sequence = 2..18446744073709551615

; =====================================================================
; Previous State Hash
; =====================================================================
;
; Contains one binary Multihash.
;
; OpenIdentity v0.1 producers MUST emit a SHA2-256 Multihash:
;
;   0x12 || 0x20 || SHA-256(StateBytes)
;
; resulting in exactly 34 bytes.
;
; The wider structural bound permits future supported Multihashes.
; A verifier MUST semantically validate the Multihash.
; =====================================================================

previous-state-hash = bstr .size (1..128)

; =====================================================================
; Recovery Commitment
; =====================================================================
;
; Multihash over deterministic RecoveryPolicyBytes.
; v0.1 producers MUST emit:
;   0x12 || 0x20 || SHA-256(RecoveryPolicyBytes)
; The v0.1 value is therefore exactly 34 bytes. The structural envelope is
; wider for future supported Multihashes.
; =====================================================================

recovery-commitment = bstr .size (1..128)

; =====================================================================
; Recovery Policy
; =====================================================================
;
; RecoveryPolicy is a distinct authorization purpose. Its methods MUST NOT
; implicitly gain controller or assertion authority.
;
; SINGLE:    { 1: version=1, 2: type=1, 3: [method] }
; THRESHOLD: { 1: version=1, 2: type=2, 3: threshold, 4: [methods...] }
; =====================================================================

recovery-policy =
      recovery-single-policy
    / recovery-threshold-policy

recovery-policy-version = 1

recovery-single-policy = {
    1 => recovery-policy-version,
    2 => single-policy-type,
    3 => [ verification-method ]
}

recovery-threshold-policy = {
    1 => recovery-policy-version,
    2 => threshold-policy-type,
    3 => threshold,
    4 => [+ verification-method]
}

; =====================================================================
; Controller Policy
; =====================================================================

controller-policy =
      single-policy
    / threshold-policy

; AssertionPolicy deliberately reuses the same policy and
; VerificationMethod structures. Authorization purpose is distinct:
; ControllerPolicy controls state; AssertionPolicy authorizes OI-003
; assertions. Membership in either MUST NOT imply membership in the other.
assertion-policy =
      single-policy
    / threshold-policy

; ---------------------------------------------------------------------
; SINGLE
;
; 1 = policy type = 1
; 2 = exactly one VerificationMethod
; ---------------------------------------------------------------------

single-policy = {
    1 => single-policy-type,
    2 => [ verification-method ]
}

single-policy-type = 1

; ---------------------------------------------------------------------
; THRESHOLD
;
; 1 = policy type = 2
; 2 = threshold
; 3 = VerificationMethods
;
; Semantic invariant:
;   1 <= threshold <= number of VerificationMethods
; ---------------------------------------------------------------------

threshold-policy = {
    1 => threshold-policy-type,
    2 => threshold,
    3 => [+ verification-method]
}

threshold-policy-type = 2
threshold = 1..65535

; =====================================================================
; Verification Method
; =====================================================================
;
; 1 = 16-byte Verification Method ID
; 2 = COSE_Key
; =====================================================================

verification-method = {
    1 => verification-method-id,
    2 => openidentity-cose-key
}

verification-method-id = bstr .size 16

; =====================================================================
; OpenIdentity COSE Keys
; =====================================================================

openidentity-cose-key =
      ed25519-cose-key
    / ml-dsa-65-cose-key

; ---------------------------------------------------------------------
; Ed25519 COSE_Key
;
;  1 = kty = 1  (OKP)
;  3 = alg = -8 (EdDSA)
; -1 = crv = 6  (Ed25519)
; -2 = x = 32-byte public key
; ---------------------------------------------------------------------

ed25519-cose-key = {
     1 => ed25519-kty,
     3 => ed25519-alg,
    -1 => ed25519-curve,
    -2 => ed25519-public-key
}

ed25519-kty = 1
ed25519-alg = -8
ed25519-curve = 6
ed25519-public-key = bstr .size 32

; ---------------------------------------------------------------------
; ML-DSA-65 COSE_Key
;
;  1 = kty = 7   (AKP)
;  3 = alg = -49 (ML-DSA-65)
; -1 = pub = 1952-byte raw public key
; ---------------------------------------------------------------------

ml-dsa-65-cose-key = {
     1 => ml-dsa-kty,
     3 => ml-dsa-65-alg,
    -1 => ml-dsa-65-public-key
}

ml-dsa-kty = 7
ml-dsa-65-alg = -49
ml-dsa-65-public-key = bstr .size 1952

; =====================================================================
; Authorization Proof
; =====================================================================
;
; 1 = Verification Method ID
; 2 = raw algorithm-specific signature bytes
; =====================================================================

authorization-proof = {
    1 => verification-method-id,
    2 => signature
}

; =====================================================================
; Controller Proof of Possession
; =====================================================================

controller-proof = {
    1 => verification-method-id,
    2 => signature
}

; =====================================================================
; Signature
; =====================================================================
;
; v0.1 semantic sizes:
;   Ed25519   = 64 bytes
;   ML-DSA-65 = 3309 bytes
; =====================================================================

signature = bstr .size (1..65535)

; =====================================================================
; Canonical Identity State
; =====================================================================
;
; v1 remains frozen. v2 adds optional AssertionPolicy at map label 7.
; =====================================================================

identity-state =
      identity-state-v1
    / identity-state-v2
    / identity-state-v3

; Canonical Identity State v1 -- frozen
identity-state-v1 = {
    1 => identity-state-version-v1,
    2 => identity-id,
    3 => state-sequence,
    4 => identity-status,
    5 => controller-policy,
    ? 6 => recovery-commitment
}

; Canonical Identity State v2
;
; 1 = state version = 2
; 2 = identity
; 3 = sequence
; 4 = status
; 5 = controller policy
; 6 = recovery commitment (optional)
; 7 = assertion policy (optional)
;
; Absence of field 7 means NO assertion authority. It MUST NOT imply
; fallback to ControllerPolicy.
identity-state-v2 = {
    1 => identity-state-version-v2,
    2 => identity-id,
    3 => state-sequence,
    4 => identity-status,
    5 => controller-policy,
    ? 6 => recovery-commitment,
    ? 7 => assertion-policy
}

identity-state-version-v1 = 1
identity-state-version-v2 = 2
identity-state-version-v3 = 3

identity-state-v3 = {
    1 => identity-state-version-v3,
    2 => identity-id,
    3 => state-sequence,
    4 => identity-status,
    5 => controller-policy,
    ? 6 => recovery-commitment,
    ? 7 => assertion-policy,
    8 => authentication-authority,
    9 => delegation-authority
}

authentication-authority = {
    1 => authority-generation,
    ? 2 => authentication-policy
}

delegation-authority = {
    1 => authority-generation,
    ? 2 => delegation-policy
}

authority-generation = 0..18446744073709551615
authentication-policy = single-policy / threshold-policy
delegation-policy = single-policy / threshold-policy
state-sequence = 1..18446744073709551615

; ---------------------------------------------------------------------
; Identity Status
;
; 1 = ACTIVE
; 2 = DEACTIVATED
; ---------------------------------------------------------------------

identity-status =
      active-status
    / deactivated-status

active-status = 1
deactivated-status = 2

; =====================================================================
; State Hash
; =====================================================================
;
; OpenIdentity state hash calculation for v1, v2, and v3:
;
;   StateBytes =
;       deterministicCBOR(identity-state)
;
;   digest =
;       SHA-256(StateBytes)
;
;   StateHash =
;       0x12 || 0x20 || digest
;
; where:
;   0x12 = Multihash SHA2-256 code
;   0x20 = 32-byte digest length
;
; StateHash is therefore 34 bytes for the v0.1 SHA2-256 profile.
;
; A subsequent operation places StateHash into previousStateHash.
; =====================================================================

; =====================================================================
; Authorization Signing Structure
; =====================================================================
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Operation",
;   1,
;   operationBytes
; ]
; =====================================================================

operation-signing-structure = [
    "OpenIdentity Operation",
    signing-structure-version,
    operation-bytes
]

; =====================================================================
; Controller Proof-of-Possession Signing Structure
; =====================================================================
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Controller Proof",
;   1,
;   operationBytes,
;   verificationMethodId
; ]
; =====================================================================

controller-proof-signing-structure = [
    "OpenIdentity Controller Proof",
    signing-structure-version,
    operation-bytes,
    verification-method-id
]

; =====================================================================
; Recovery Authorization Proof
; =====================================================================

recovery-proof = {
    1 => verification-method-id,
    2 => signature
}

recovery-proof-signing-structure = [
    "OpenIdentity Recovery",
    signing-structure-version,
    operation-bytes,
    verification-method-id
]

signing-structure-version = 1

; =====================================================================
; Operation Bytes
; =====================================================================
;
; Complete deterministic RFC 8949 CBOR encoding of exactly one valid
; OpenIdentity Operation. It excludes authorization proofs and
; transport metadata.
; =====================================================================

operation-bytes = bstr

; =====================================================================
; Canonical Ordering Requirements
; =====================================================================
;
; VerificationMethods within every ControllerPolicy, AssertionPolicy,
; AuthenticationPolicy, DelegationPolicy, and RecoveryPolicy MUST be sorted by Verification Method ID using unsigned bytewise
; lexicographic ordering.
;
; The same VerificationMethod MAY appear in both policies only when
; explicitly present in both. Membership never transfers implicitly.
;
; Authorization proofs and every purpose-specific proof collection MUST use
; Verification Method ID ordering matching the applicable policy.
;
; Duplicate Verification Method IDs MUST be rejected within each relevant
; collection. ProtocolVersion 2 additionally rejects duplicate effective
; cryptographic keys within one VerificationPolicy. Effective key equality is
; determined by byte equality of deterministic-CBOR encoding of the fully
; validated COSE_Key. This prevents the same exact cryptographic key from
; satisfying multiple threshold positions under different method IDs.
; =====================================================================

; =====================================================================
; Deterministic CBOR Requirements
; =====================================================================
;
; Canonical serialization semantics are defined by OI-009.
;
; Every cryptographically authoritative structure MUST use RFC 8949
; Core Deterministic Encoding Requirements.
;
; OpenIdentity v0.1 additionally requires:
;
; - definite-length byte/text strings, arrays, and maps
; - preferred integer serialization
; - deterministic map-key ordering
; - rejection of duplicate map keys
; - rejection of unknown OpenIdentity-defined map labels
; - optional map fields are omitted when absent
; - nil is encoded only where the schema explicitly gives nil semantic meaning
; - no floating-point values
; - no NaN or Infinity
; - no undefined
; - no arbitrary CBOR tags
; - no unassigned simple values
;
; Negative integers are permitted where explicitly required by
; standardized COSE structures and identifiers.
; =====================================================================

; =====================================================================
; ProtocolVersion 2 State-Transition Summary
; =====================================================================
;
; Every successful protocolVersion 2 state-changing operation produces
; IdentityState v3. Applying protocolVersion 1 to IdentityState v3 is invalid.
;
; CREATE:
; - produces ACTIVE IdentityState v3 at sequence 1
; - initializes AuthenticationAuthority.generation = 0
; - initializes DelegationAuthority.generation = 0
; - field 2 authorizes CREATE under the proposed ControllerPolicy
; - redundant field-3 Controller PoP is structurally forbidden
; - each installed derived policy requires complete purpose-specific PoP
;
; ROTATE_CONTROLLER:
; - requires ACTIVE current state
; - increments sequence and chains from current StateHash
; - current ControllerPolicy authorizes the operation
; - field 3 proves possession of every proposed controller method
; - preserves recoveryCommitment, AssertionPolicy, AuthenticationAuthority,
;   DelegationAuthority, and status
;
; RECOVER:
; - MAY apply to ACTIVE or DEACTIVATED current state
; - increments sequence and chains from current StateHash
; - is authorized exclusively by the committed RecoveryPolicy
; - installs replacement ControllerPolicy after complete field-3 PoP
; - rotates recoveryCommitment and sets status ACTIVE
; - handles an existing AssertionPolicy by explicit PRESERVE/REMOVE/REPLACE
; - REPLACE requires complete field-6 Assertion PoP
; - clears AuthenticationPolicy and increments authentication generation
; - clears DelegationPolicy and increments delegation generation
;
; DEACTIVATE:
; - requires ACTIVE current state
; - increments sequence and sets status DEACTIVATED
; - preserves all authority structures and generations
;
; SET_ASSERTION_POLICY:
; - requires ACTIVE current state and current ControllerPolicy authorization
; - non-nil replacement requires complete field-6 Assertion PoP
; - preserves all unrelated state and increments sequence
;
; SET_AUTHENTICATION_POLICY / SET_DELEGATION_POLICY:
; - require ACTIVE current state and current ControllerPolicy authorization
; - non-nil installation/replacement requires complete purpose-specific PoP
; - generation transitions follow the disposition semantics in the v3 spec
;
; RESET_AUTHENTICATION / RESET_DELEGATIONS:
; - require ACTIVE current state and current ControllerPolicy authorization
; - increment only the applicable generation and identity sequence
;
; Upgrade:
; - v1 + successful protocolVersion 2 operation => v3
; - v2 + successful protocolVersion 2 operation => v3
; - v3 + successful protocolVersion 2 operation => v3
; - v3 + protocolVersion 1 operation => invalid
; - v3 -> v1/v2 downgrade is forbidden
;
; =====================================================================
; Assertion Authority and Historical State
; =====================================================================
;
; AssertionPolicy is the sole canonical source of OI-003 assertion
; authority and projects to W3C assertionMethod.
;
; ControllerPolicy membership MUST NOT imply assertion authority.
; AssertionPolicy membership MUST NOT imply controller authority.
;
; StateHash commits to the complete IdentityState, including state
; version and AssertionPolicy when present. OI-003 uses StateHash as the
; cryptographic historical-state identifier. The did:open resolution
; profile exposes that identifier using DID Resolution versionId.
;
; Current projections expose only current assertion authority.
; Historical credential verification MUST evaluate AssertionPolicy from
; the exact historical authoritative state bound by StateHash/versionId.
; =====================================================================

; =====================================================================
; Recovery Authority Separation
; =====================================================================
;
; RecoveryPolicy authorizes RECOVER only. ControllerPolicy and
; AssertionPolicy MUST NOT implicitly authorize RECOVER, and RecoveryPolicy
; membership MUST NOT imply either controller or assertion authority.
;
; Recovery proofs, ordinary authorization proofs, and controller proofs use
; distinct signing domains and are not interchangeable.
;
; Delays, social-recovery UX, MPC, secret sharing, guardians, inheritance,
; and registry-specific workflows are outside this wire-format version.
; =====================================================================

; =====================================================================
; End OpenIdentity Operation Wire Format v3
; =====================================================================


; =====================================================================
; ProtocolVersion 2 semantic requirements not expressible in CDDL
; =====================================================================
;
; - CREATE uses proposed ControllerPolicy authorization in field 2 and MUST NOT
;   require redundant field-3 controller PoPs.
; - Derived policies installed by CREATE require complete purpose-specific PoP.
; - ProtocolVersion 2 success against state v1/v2 upgrades the result to v3.
; - ProtocolVersion 1 MUST NOT operate on IdentityState v3.
; - Within one VerificationPolicy, effective public-key material MUST be unique
;   in addition to VerificationMethod ID uniqueness.
; - Authority generation is preserved or incremented by exactly one according
;   to operation semantics; it never decreases, jumps, or wraps.
; - RECOVER always clears AuthenticationPolicy and DelegationPolicy and
;   increments both generations.
; - Delegation grants become authoritative only through network registration
;   under the current DelegationPolicy; registration does not mutate root
;   IdentityState.
