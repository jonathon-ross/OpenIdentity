; =====================================================================
; OpenIdentity Credential Wire Format v1
; File: spec/cddl/openidentity-credential-v1.cddl
; =====================================================================
;
; Status:
;   Initial OI-003 canonical credential schema.
;
; Dependencies:
;   Reuses the primitive encodings and assertion-authority semantics
;   defined by spec/cddl/openidentity-operation-v2.cddl.
;
; Normative encoding:
;   RFC 8949 Core Deterministic Encoding Requirements plus the
;   OpenIdentity restrictions stated below.
;
; This schema defines the canonical OpenIdentity credential representation.
; W3C Verifiable Credential representations are deterministic projections
; of this canonical representation; they are not the cryptographic source
; of truth for OI-003.
; =====================================================================

start = secured-credential

; =====================================================================
; Secured Credential
; =====================================================================
;
; 1 = canonical OpenIdentityCredential
; 2 = assertion proofs
;
; Every proof signs the same CredentialSigningInput. The historical
; AssertionPolicy committed to by issuanceStateHash determines whether the
; supplied proof set satisfies issuer assertion authority.
; =====================================================================

secured-credential = {
    1 => openidentity-credential,
    2 => [+ credential-proof]
}

; =====================================================================
; Canonical OpenIdentity Credential
; =====================================================================
;
; 1 = credential version
; 2 = credential ID
; 3 = issuer OpenIdentity identity
; 4 = issuance StateHash
; 5 = valid from
; 6 = valid until (optional)
; 7 = credential profile
; 8 = credential subject
; 9 = claims
;
; issuance-state-hash and credential-profile are inside CredentialBytes.
; Every credential proof therefore cryptographically commits to both.
;
; Verification Method IDs are NOT duplicated in this payload. Each proof
; identifies its VerificationMethod, while issuance-state-hash identifies
; the historical AssertionPolicy that determines which methods and
; threshold were authoritative at issuance.
; =====================================================================

openidentity-credential = {
    1 => credential-version,
    2 => credential-id,
    3 => issuer-identity,
    4 => issuance-state-hash,
    5 => valid-from,
    ? 6 => valid-until,
    7 => credential-profile,
    8 => credential-subject,
    9 => claims
}

credential-version = 1

; =====================================================================
; Credential ID
; =====================================================================
;
; A 32-byte opaque identifier unique within the issuer's credential
; namespace. Generation requirements are defined by OI-003.
; =====================================================================

credential-id = bstr .size 32

; =====================================================================
; Issuer Identity
; =====================================================================
;
; Raw 32-byte OpenIdentity identity identifier.
;
; This is the same binary identity-id representation defined by
; openidentity-operation-v2.cddl. The textual did:open representation MUST
; NOT appear in the canonical credential.
; =====================================================================

issuer-identity = bstr .size 32

; =====================================================================
; Issuance State Hash
; =====================================================================
;
; Identifies the exact historical authoritative IdentityState whose
; AssertionPolicy authorized issuance.
;
; OpenIdentity v0.1 producers MUST emit the same SHA2-256 Multihash used
; for IdentityState:
;
;   0x12 || 0x20 || SHA-256(StateBytes)
;
; which is exactly 34 bytes.
;
; The wider structural bound permits future supported Multihashes.
; A verifier MUST validate the Multihash and MUST resolve/evaluate the
; exact historical state identified by this value. It MUST NOT substitute
; the current IdentityState.
; =====================================================================

issuance-state-hash = bstr .size (1..128)

; =====================================================================
; Validity Period
; =====================================================================
;
; valid-from and valid-until are unsigned integer seconds from the Unix
; epoch (1970-01-01T00:00:00Z).
;
; Semantic requirements:
; - valid-until, when present, MUST be greater than valid-from.
; - validity-period evaluation is separate from signature verification,
;   historical assertion authorization, and credential status.
; =====================================================================

valid-from = uint
valid-until = uint

; =====================================================================
; Credential Profile
; =====================================================================
;
; credential-profile is an absolute URI identifying one immutable version
; of an OpenIdentity Credential Profile.
;
; A Credential Profile defines application semantics including:
; - permitted and required claims
; - claim value constraints
; - semantic meaning
; - privacy/security considerations
; - W3C projection rules, including credential type/context mappings
;
; Profile version identifiers are immutable. An incompatible profile
; change MUST use a new profile URI/version.
;
; The URI is an identifier, NOT an instruction to perform network access.
; A verifier MUST NOT dereference credential-profile as a prerequisite for
; cryptographic verification.
;
; If cryptographic verification succeeds but the verifier does not support
; the identified profile, profile validation MUST be INDETERMINATE with
; reason UNSUPPORTED_CREDENTIAL_PROFILE rather than cryptographically
; INVALID solely because the profile is unknown.
;
; Absolute-URI syntax is a semantic requirement not expressible by this
; CDDL production.
; =====================================================================

credential-profile = tstr .size (1..2048)

; =====================================================================
; Credential Subject
; =====================================================================
;
; Opaque subject identifier bytes interpreted by the Credential Profile.
;
; The subject identifier is intentionally not restricted to an
; OpenIdentity identity. Profiles can therefore describe people,
; organizations, devices, resources, documents, or other subjects.
;
; A profile MUST define the syntax and semantics of credential-subject.
; =====================================================================

credential-subject = bstr .size (1..65535)

; =====================================================================
; Claims
; =====================================================================
;
; Claims use UTF-8 text keys and a deliberately restricted CBOR value
; model. `any` is NOT permitted.
;
; The generic wire schema provides deterministic transport and a safe
; cross-language value universe. The Credential Profile defines the exact
; permitted/required claim keys, nesting, types, and semantics.
;
; A credential MUST contain at least one claim.
;
; Claim maps:
; - MUST use text-string keys
; - MUST reject duplicate keys
; - MUST use deterministic CBOR map-key ordering
;
; The v1 claim model deliberately excludes:
; - floating-point values
; - undefined
; - arbitrary CBOR tags
; - unassigned simple values
; - indefinite-length encodings
;
; Negative integers are permitted as claim values.
; =====================================================================

claims = {
    + claim-entry
}

claim-entry = (
    claim-key => claim-value
)

claim-key = tstr .size (1..1024)

claim-value =
      int
    / tstr
    / bstr
    / bool
    / nil
    / claim-array
    / claim-map

claim-array = [* claim-value]

claim-map = {
    * claim-entry
}

; =====================================================================
; Credential Proof
; =====================================================================
;
; 1 = Verification Method ID
; 2 = raw algorithm-specific signature
;
; verification-method-id and signature use the same primitive encodings
; defined by openidentity-operation-v2.cddl.
;
; The method identified by each proof MUST exist in the AssertionPolicy
; of the exact historical IdentityState identified by
; issuance-state-hash.
;
; Proofs from ControllerPolicy do not acquire assertion authority unless
; the same VerificationMethod is also explicitly present in the historical
; AssertionPolicy.
; =====================================================================

credential-proof = {
    1 => verification-method-id,
    2 => credential-signature
}

verification-method-id = bstr .size 16

; v0.1 semantic signature sizes:
;   Ed25519   = 64 bytes
;   ML-DSA-65 = 3309 bytes
credential-signature = bstr .size (1..65535)

; =====================================================================
; Credential Signing Structure
; =====================================================================
;
; CredentialBytes is the complete deterministic RFC 8949 CBOR encoding
; of exactly one openidentity-credential.
;
; Every credential proof signs the deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Credential",
;   1,
;   CredentialBytes
; ]
;
; This domain separates credential signatures from operation
; authorization, proof-of-possession, and all other OpenIdentity
; signatures.
; =====================================================================

credential-signing-structure = [
    "OpenIdentity Credential",
    credential-signing-structure-version,
    credential-bytes
]

credential-signing-structure-version = 1
credential-bytes = bstr

; =====================================================================
; Historical Assertion Authorization
; =====================================================================
;
; For a secured credential C:
;
; 1. Parse and deterministically validate C.openidentity-credential.
; 2. Read issuer-identity and issuance-state-hash from the signed payload.
; 3. Resolve/load the exact historical IdentityState identified by those
;    values.
; 4. Recompute StateHash and require equality with issuance-state-hash.
; 5. Require a supported IdentityState containing AssertionPolicy.
; 6. Evaluate each credential-proof only against VerificationMethods in
;    that historical AssertionPolicy.
; 7. Reconstruct CredentialBytes and CredentialSigningInput.
; 8. Reject duplicate, unauthorized, or cryptographically invalid
;    supplied proofs according to the Proof Collection Requirements.
; 9. Require the remaining supplied proof set to satisfy the historical
;    AssertionPolicy's SINGLE/THRESHOLD semantics.
;
; The current IdentityState MUST NOT replace the bound historical state
; during this authorization decision.
;
; Later replacement/removal of AssertionPolicy does not retroactively
; alter the historical IdentityState. Credential status/revocation is a
; separate mechanism.
; =====================================================================

; =====================================================================
; Proof Collection Requirements
; =====================================================================
;
; OI-003 v1 uses strict proof-set validation. Threshold satisfaction MUST
; NOT cause a verifier to ignore additional supplied proofs.
;
; Credential proofs MUST be sorted by Verification Method ID using
; unsigned bytewise lexicographic ordering.
;
; Every supplied proof MUST use a distinct Verification Method ID.
; Duplicate Verification Method IDs MUST cause verification to fail with:
;
;   DUPLICATE_CREDENTIAL_PROOF
;
; Every supplied credential-proof MUST identify a VerificationMethod
; explicitly present in the AssertionPolicy of the exact historical
; IdentityState identified by issuance-state-hash.
;
; A proof whose VerificationMethod is absent from that AssertionPolicy
; MUST cause verification to fail with:
;
;   UNAUTHORIZED_CREDENTIAL_PROOF
;
; Such a proof MUST NOT be ignored, even when other valid proofs already
; satisfy the historical AssertionPolicy threshold.
;
; Every supplied credential-proof MUST cryptographically verify using the
; algorithm and public key bound to its VerificationMethod by the
; historical AssertionPolicy.
;
; Any supplied proof whose signature fails verification MUST cause
; credential verification to fail with:
;
;   INVALID_CREDENTIAL_SIGNATURE
;
; For SINGLE:
; - exactly one credential-proof MUST be present
; - its Verification Method ID MUST equal the SINGLE policy method
; - its signature MUST cryptographically verify
;
; For THRESHOLD:
; - every supplied proof MUST be distinct, authorized, and valid
; - the number of valid supplied proofs MUST be >= threshold
; - the number of supplied proofs MAY exceed threshold
; - the number of supplied proofs MUST NOT exceed the number of
;   VerificationMethods in the historical AssertionPolicy
;
; Threshold evaluation counts distinct authorized Verification Method IDs,
; never raw signature count.
;
; If fewer than `threshold` distinct authorized valid proofs are supplied,
; verification MUST fail with:
;
;   ASSERTION_THRESHOLD_NOT_SATISFIED
;
; Because secured-credential structurally requires [+ credential-proof],
; an empty proof collection is structurally invalid before semantic
; assertion-policy evaluation.
;
; Algorithm selection MUST come from the historical VerificationMethod's
; COSE_Key. credential-proof deliberately carries no independent algorithm
; identifier that could conflict with the authoritative historical key.
; =====================================================================

; =====================================================================
; Profile Processing
; =====================================================================
;
; Credential processing has three distinct result layers:
;
; 1. Cryptographic verification
;      VALID / INVALID
;
; 2. Credential Profile validation
;      VALID / INVALID / INDETERMINATE
;
; 3. Application acceptance
;      ACCEPT / REJECT
;
; An unsupported credential-profile does not by itself make an otherwise
; cryptographically valid credential cryptographically INVALID.
;
; Implementations SHOULD use locally installed/registered trusted profile
; handlers. Automatic network retrieval of arbitrary profile URIs MUST NOT
; be required by the cryptographic verification algorithm.
; =====================================================================

; =====================================================================
; W3C Projection
; =====================================================================
;
; A Credential Profile defines the deterministic projection from the
; canonical OpenIdentity credential into its W3C Verifiable Credential
; representation.
;
; At minimum, the projection is expected to map:
; - issuer-identity to the did:open issuer identifier
; - credential-subject and claims to credentialSubject
; - valid-from / valid-until to the W3C validity period
; - credential-profile to the profile-defined W3C type/context semantics
; - credential proofs to assertionMethod proof semantics
;
; The W3C representation is not the cryptographic source of truth for
; native OI-003 credential signatures.
; =====================================================================

; =====================================================================
; Deterministic CBOR Requirements
; =====================================================================
;
; Every cryptographically authoritative OI-003 structure MUST use RFC 8949
; Core Deterministic Encoding Requirements.
;
; OI-003 v1 additionally requires:
;
; - definite-length byte/text strings, arrays, and maps
; - preferred integer serialization
; - deterministic map-key ordering
; - rejection of duplicate map keys
; - rejection of unknown OpenIdentity-defined core map labels
; - no floating-point values
; - no NaN or Infinity
; - no undefined
; - no arbitrary CBOR tags
; - no unassigned simple values
;
; Negative integers are permitted in claim values and where explicitly
; required by standardized cryptographic structures.
; =====================================================================

; =====================================================================
; Separation of Concerns
; =====================================================================
;
; Historical assertion authorization answers:
;   "Was this VerificationMethod authorized to assert for this issuer at
;    the exact bound IdentityState?"
;
; Signature verification answers:
;   "Did the authorized key sign these exact CredentialBytes?"
;
; Profile validation answers:
;   "Do the claims conform to the identified Credential Profile?"
;
; Validity-period evaluation answers:
;   "Is the credential within its issuer-declared time window?"
;
; Credential status answers:
;   "Has the credential been revoked, suspended, or otherwise changed in
;    status?"
;
; Application policy answers:
;   "Should this verifier accept this credential for this purpose?"
;
; These questions MUST NOT be silently collapsed into one another.
; =====================================================================

; =====================================================================
; End OpenIdentity Credential Wire Format v1
; =====================================================================
