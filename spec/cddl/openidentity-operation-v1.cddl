; =====================================================================
; HISTORICAL / FROZEN SCHEMA NOTICE
; =====================================================================
;
; This file preserves the earlier OpenIdentity Operation Wire Format v1
; for historical compatibility and verification of frozen artifacts.
;
; Current OpenIdentity protocol development uses:
;
;   spec/cddl/openidentity-operation-v2.cddl
;
; Do not interpret omissions or reserved operations in this historical
; schema as limitations of the current v2 schema.
; =====================================================================
;
; =====================================================================
; OpenIdentity Operation Wire Format v1
; File: spec/cddl/openidentity-operation-v1.cddl
; =====================================================================
;
; Normative encoding: RFC 8949 Core Deterministic Encoding Requirements
; plus restrictions in docs/cryptographic-agility.md.
;
; CDDL defines structural validity. Semantic requirements such as
; ordering, threshold evaluation, signature verification, replay
; protection, and proof-of-possession are defined in the specification.
; =====================================================================

start = signed-operation

; ---------------------------------------------------------------------
; Signed operation envelope
; 1 = operation
; 2 = authorization proofs
; ---------------------------------------------------------------------

signed-operation = {
    1 => operation,
    2 => [+ authorization-proof]
}

; ---------------------------------------------------------------------
; Operations
; Each operation type is structurally bound to its correct payload.
; ---------------------------------------------------------------------

operation =
      create-operation
    / rotate-controller-operation
    / deactivate-operation

; ---------------------------------------------------------------------
; Operation Type Registry
;
; 1 = CREATE
; 2 = ROTATE_CONTROLLER
; 3 = RECOVER (allocated, but NOT defined/valid in this schema)
; 4 = DEACTIVATE
;
; 5..23 reserved for future OpenIdentity core operations.
; ---------------------------------------------------------------------

create-operation-type = 1
rotate-controller-operation-type = 2
recover-operation-type = 3
deactivate-operation-type = 4

; ---------------------------------------------------------------------
; CREATE
;
; Structurally enforced:
; protocolVersion = 1
; operationType = 1
; sequence = 1
; previousStateHash = nil
; ---------------------------------------------------------------------

create-operation = {
    1 => protocol-version,
    2 => create-operation-type,
    3 => identity-id,
    4 => create-sequence,
    5 => nil,
    6 => create-payload
}

create-sequence = 1

create-payload = {
    1 => controller-policy,
    ? 2 => recovery-commitment
}

; ---------------------------------------------------------------------
; ROTATE_CONTROLLER
; ---------------------------------------------------------------------

rotate-controller-operation = {
    1 => protocol-version,
    2 => rotate-controller-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => rotate-controller-payload
}

rotate-controller-payload = {
    1 => controller-policy,
    2 => [+ controller-proof]
}

; ---------------------------------------------------------------------
; DEACTIVATE
; ---------------------------------------------------------------------

deactivate-operation = {
    1 => protocol-version,
    2 => deactivate-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => deactivate-payload
}

deactivate-payload = {}

; ---------------------------------------------------------------------
; Protocol version
; ---------------------------------------------------------------------

protocol-version = 1

; ---------------------------------------------------------------------
; Root identity identifier
; Exactly the raw 32 identifier bytes defined by OI-001.
; ---------------------------------------------------------------------

identity-id = bstr .size 32

; ---------------------------------------------------------------------
; Sequence
; CREATE is fixed to 1. Subsequent operations are uint64 >= 2.
; The currentSequence + 1 relationship is checked semantically.
; ---------------------------------------------------------------------

subsequent-sequence = 2..18446744073709551615

; ---------------------------------------------------------------------
; Previous state hash
;
; Binary Multihash. v0.1 requires SHA2-256 support.
; The broader structural bound permits future supported Multihashes.
; ---------------------------------------------------------------------

previous-state-hash = bstr .size (1..128)

; ---------------------------------------------------------------------
; Recovery commitment
; Opaque until the recovery specification defines its format.
; ---------------------------------------------------------------------

recovery-commitment = bstr .size (1..128)

; ---------------------------------------------------------------------
; Controller Policy
; ---------------------------------------------------------------------

controller-policy =
      single-policy
    / threshold-policy

; SINGLE:
; 1 = policy type (1)
; 2 = exactly one verification method

single-policy = {
    1 => single-policy-type,
    2 => [ verification-method ]
}

single-policy-type = 1

; THRESHOLD:
; 1 = policy type (2)
; 2 = threshold
; 3 = verification methods
;
; Semantic invariant:
; 1 <= threshold <= number of verification methods

threshold-policy = {
    1 => threshold-policy-type,
    2 => threshold,
    3 => [+ verification-method]
}

threshold-policy-type = 2
threshold = 1..65535

; ---------------------------------------------------------------------
; Verification Method
;
; 1 = 16-byte verification method ID
; 2 = COSE_Key
; ---------------------------------------------------------------------

verification-method = {
    1 => verification-method-id,
    2 => openidentity-cose-key
}

verification-method-id = bstr .size 16

; ---------------------------------------------------------------------
; OpenIdentity COSE keys
; ---------------------------------------------------------------------

openidentity-cose-key =
      ed25519-cose-key
    / ml-dsa-65-cose-key

; ---------------------------------------------------------------------
; Ed25519 COSE_Key
;
;  1 = kty = 1 (OKP)
;  3 = alg = -8 (EdDSA)
; -1 = crv = 6 (Ed25519)
; -2 = x = 32-byte public key
; ---------------------------------------------------------------------

ed25519-cose-key = {
     1 => ed25519-kty,
     3 => ed25519-alg,
    -1 => ed25519-curve,
    -2 => ed25519-public-key
}

ed25519-kty = 1
ed25519-alg = -8
ed25519-curve = 6
ed25519-public-key = bstr .size 32

; ---------------------------------------------------------------------
; ML-DSA-65 COSE_Key
;
;  1 = kty = 7 (AKP)
;  3 = alg = -49 (ML-DSA-65)
; -1 = pub = 1952-byte raw public key
; ---------------------------------------------------------------------

ml-dsa-65-cose-key = {
     1 => ml-dsa-kty,
     3 => ml-dsa-65-alg,
    -1 => ml-dsa-65-public-key
}

ml-dsa-kty = 7
ml-dsa-65-alg = -49
ml-dsa-65-public-key = bstr .size 1952

; ---------------------------------------------------------------------
; Authorization Proof
;
; 1 = verification method ID
; 2 = raw signature bytes
; ---------------------------------------------------------------------

authorization-proof = {
    1 => verification-method-id,
    2 => signature
}

; ---------------------------------------------------------------------
; Controller Proof of Possession
;
; Used by ROTATE_CONTROLLER for proposed new keys.
; ---------------------------------------------------------------------

controller-proof = {
    1 => verification-method-id,
    2 => signature
}

; ---------------------------------------------------------------------
; Signature
;
; Algorithm-specific semantic validation determines exact size.
;
; v0.1:
; Ed25519   = 64 bytes
; ML-DSA-65 = 3309 bytes
; ---------------------------------------------------------------------

signature = bstr .size (1..65535)

; ---------------------------------------------------------------------
; Authorization Signing Structure
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Operation",
;   1,
;   operationBytes
; ]
; ---------------------------------------------------------------------

operation-signing-structure = [
    "OpenIdentity Operation",
    signing-structure-version,
    operation-bytes
]

; ---------------------------------------------------------------------
; Controller Proof-of-Possession Signing Structure
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Controller Proof",
;   1,
;   operationBytes,
;   verificationMethodId
; ]
; ---------------------------------------------------------------------

controller-proof-signing-structure = [
    "OpenIdentity Controller Proof",
    signing-structure-version,
    operation-bytes,
    verification-method-id
]

signing-structure-version = 1

; ---------------------------------------------------------------------
; Operation Bytes
;
; Complete deterministic RFC 8949 CBOR encoding of exactly one valid
; OpenIdentity Operation. It excludes authorization proofs and transport
; metadata.
; ---------------------------------------------------------------------

operation-bytes = bstr

; =====================================================================
; Normative Semantic Requirements
; =====================================================================

; ---------------------------------------------------------------------
; Canonical Ordering
;
; Verification methods MUST be sorted by verification-method-id using
; unsigned bytewise lexicographic ordering.
;
; Authorization proofs and controller proofs MUST use the same ordering.
;
; Duplicate verification-method-id values MUST be rejected within each
; relevant collection.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; Deterministic CBOR
;
; Every cryptographically authoritative structure MUST use RFC 8949
; Core Deterministic Encoding Requirements.
;
; OpenIdentity v0.1 additionally requires:
;
; - definite-length byte/text strings, arrays, and maps
; - preferred integer serialization
; - deterministic map-key ordering
; - rejection of duplicate map keys
; - rejection of unknown OpenIdentity-defined map labels
; - no floating-point values
; - no NaN or Infinity
; - no undefined
; - no arbitrary CBOR tags
; - no unassigned simple values
;
; Negative integers are permitted where explicitly required by
; standardized COSE structures and identifiers.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; CREATE Semantics
;
; MUST have:
; protocolVersion   = 1
; operationType     = 1
; identity length   = 32 bytes
; sequence          = 1
; previousStateHash = nil
;
; CREATE authorization is evaluated against the controller policy in
; the CREATE payload.
;
; Default v0.1 profile:
; THRESHOLD, threshold=2, one Ed25519 method, one ML-DSA-65 method.
; Both authorization proofs MUST be valid.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; ROTATE_CONTROLLER Semantics
;
; MUST have:
; protocolVersion = 1
; operationType    = 2
; sequence         = current authoritative sequence + 1
; previousStateHash = valid Multihash of current authoritative state
;
; Authorization is evaluated against the CURRENT controller policy.
; The proposed new policy MUST NOT authorize its own installation.
;
; Every proposed new VerificationMethod MUST provide valid proof of
; possession using controller-proof-signing-structure.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; DEACTIVATE Semantics
;
; MUST have:
; protocolVersion = 1
; operationType    = 4
; sequence         = current authoritative sequence + 1
; previousStateHash = valid Multihash of current authoritative state
;
; Normal controller authorization is required under v1.
; Final permanence, delay, and recovery semantics are separate.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; RECOVER Reservation
;
; Code 3 is allocated to RECOVER but intentionally absent from the
; `operation` choice.
;
; A conforming implementation of this schema MUST reject operationType 3.
;
; RECOVER will be added only after its payload, recovery policy,
; threshold rules, timing rules, cryptographic-diversity requirements,
; and authorization proof semantics have been normatively defined.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; Proof Evaluation
;
; A proof counts toward a controller threshold only when:
;
; - its Verification Method ID is authorized by the applicable policy
; - the referenced COSE_Key is structurally valid
; - the algorithm is supported/permitted for the operation
; - the signature representation is valid for that algorithm
; - cryptographic verification against the exact SigningInput succeeds
; - the Verification Method ID has not already been counted
;
; Thresholds MUST NOT be silently weakened.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; Proof of Possession
;
; Every VerificationMethod installed by ROTATE_CONTROLLER MUST have
; exactly one valid corresponding controller-proof unless a future
; specification explicitly defines a safe exception.
;
; Authorization proofs and possession proofs are domain-separated and
; MUST NOT be interchangeable.
; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; Future Algorithm Handling
;
; A structurally valid but unsupported algorithm is:
;
; UNSUPPORTED_ALGORITHM
;
; It MUST NOT automatically make the identity malformed.
;
; If the unsupported algorithm is required to satisfy the active
; controller threshold, authorization fails.
; ---------------------------------------------------------------------

; =====================================================================
; End OpenIdentity Operation Wire Format v1
; =====================================================================
