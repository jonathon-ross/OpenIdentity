; =====================================================================
; OpenIdentity Operation Wire Format v1
; File: spec/cddl/openidentity-operation-v1.cddl
; =====================================================================
;
; Normative encoding:
;   RFC 8949 Core Deterministic Encoding Requirements plus the
;   restrictions defined by docs/cryptographic-agility.md.
;
; CDDL defines structural validity. Semantic requirements such as
; canonical collection ordering, threshold evaluation, signature
; verification, state-transition validation, replay protection, and
; proof-of-possession are defined by the specification.
; =====================================================================

start = signed-operation

; =====================================================================
; Signed Operation
; =====================================================================
;
; 1 = operation
; 2 = authorization proofs
; 3 = controller proof-of-possession proofs (optional)
;
; No proof collection is included when calculating OperationBytes.
;
; CREATE normally omits field 3.
; ROTATE_CONTROLLER requires field 3 semantically and MUST provide
; exactly one valid controller proof for every VerificationMethod in
; the proposed new controller policy.
; =====================================================================

signed-operation = {
    1 => operation,
    2 => [+ authorization-proof],
    ? 3 => [+ controller-proof]
}

; =====================================================================
; Operations
; =====================================================================
;
; Each valid operation type is structurally bound to its payload.
; RECOVER is allocated but intentionally absent until defined.
; =====================================================================

operation =
      create-operation
    / rotate-controller-operation
    / deactivate-operation

; =====================================================================
; Operation Type Registry
; =====================================================================
;
; 1 = CREATE
; 2 = ROTATE_CONTROLLER
; 3 = RECOVER (allocated, NOT valid in this schema)
; 4 = DEACTIVATE
;
; 5..23 reserved for future OpenIdentity core operations.
; =====================================================================

create-operation-type = 1
rotate-controller-operation-type = 2
recover-operation-type = 3
deactivate-operation-type = 4

; =====================================================================
; CREATE
; =====================================================================
;
; Structurally enforced:
;   protocolVersion   = 1
;   operationType     = 1
;   sequence          = 1
;   previousStateHash = nil
; =====================================================================

create-operation = {
    1 => protocol-version,
    2 => create-operation-type,
    3 => identity-id,
    4 => create-sequence,
    5 => nil,
    6 => create-payload
}

create-sequence = 1

; 1 = controller policy
; 2 = recovery commitment (optional)

create-payload = {
    1 => controller-policy,
    ? 2 => recovery-commitment
}

; =====================================================================
; ROTATE_CONTROLLER
; =====================================================================
;
; Semantic requirements:
;   sequence = current authoritative sequence + 1
;   previousStateHash = hash of current canonical IdentityState
;
; The CURRENT controller policy authorizes the operation.
; Proposed new keys prove possession separately.
; =====================================================================

rotate-controller-operation = {
    1 => protocol-version,
    2 => rotate-controller-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => rotate-controller-payload
}

; 1 = proposed new controller policy
;
; Controller proof-of-possession evidence is deliberately NOT part of
; the operation payload because those proofs sign OperationBytes.
; Including them here would create a circular signing dependency.
;
; The proofs are carried in field 3 of signed-operation.

rotate-controller-payload = {
    1 => controller-policy
}

; =====================================================================
; DEACTIVATE
; =====================================================================

deactivate-operation = {
    1 => protocol-version,
    2 => deactivate-operation-type,
    3 => identity-id,
    4 => subsequent-sequence,
    5 => previous-state-hash,
    6 => deactivate-payload
}

deactivate-payload = {}

; =====================================================================
; Protocol Version
; =====================================================================

protocol-version = 1

; =====================================================================
; Root Identity Identifier
; =====================================================================
;
; Exactly the raw 32 identifier bytes defined by OI-001.
; The textual did:open:z... representation MUST NOT appear in the
; canonical operation or canonical IdentityState.
; =====================================================================

identity-id = bstr .size 32

; =====================================================================
; Sequence
; =====================================================================

subsequent-sequence = 2..18446744073709551615

; =====================================================================
; Previous State Hash
; =====================================================================
;
; Contains one binary Multihash.
;
; OpenIdentity v0.1 producers MUST emit a SHA2-256 Multihash:
;
;   0x12 || 0x20 || SHA-256(StateBytes)
;
; resulting in exactly 34 bytes.
;
; The wider structural bound permits future supported Multihashes.
; A verifier MUST semantically validate the Multihash.
; =====================================================================

previous-state-hash = bstr .size (1..128)

; =====================================================================
; Recovery Commitment
; =====================================================================
;
; Opaque until the recovery specification defines its format.
; =====================================================================

recovery-commitment = bstr .size (1..128)

; =====================================================================
; Controller Policy
; =====================================================================

controller-policy =
      single-policy
    / threshold-policy

; ---------------------------------------------------------------------
; SINGLE
;
; 1 = policy type = 1
; 2 = exactly one VerificationMethod
; ---------------------------------------------------------------------

single-policy = {
    1 => single-policy-type,
    2 => [ verification-method ]
}

single-policy-type = 1

; ---------------------------------------------------------------------
; THRESHOLD
;
; 1 = policy type = 2
; 2 = threshold
; 3 = VerificationMethods
;
; Semantic invariant:
;   1 <= threshold <= number of VerificationMethods
; ---------------------------------------------------------------------

threshold-policy = {
    1 => threshold-policy-type,
    2 => threshold,
    3 => [+ verification-method]
}

threshold-policy-type = 2
threshold = 1..65535

; =====================================================================
; Verification Method
; =====================================================================
;
; 1 = 16-byte Verification Method ID
; 2 = COSE_Key
; =====================================================================

verification-method = {
    1 => verification-method-id,
    2 => openidentity-cose-key
}

verification-method-id = bstr .size 16

; =====================================================================
; OpenIdentity COSE Keys
; =====================================================================

openidentity-cose-key =
      ed25519-cose-key
    / ml-dsa-65-cose-key

; ---------------------------------------------------------------------
; Ed25519 COSE_Key
;
;  1 = kty = 1  (OKP)
;  3 = alg = -8 (EdDSA)
; -1 = crv = 6  (Ed25519)
; -2 = x = 32-byte public key
; ---------------------------------------------------------------------

ed25519-cose-key = {
     1 => ed25519-kty,
     3 => ed25519-alg,
    -1 => ed25519-curve,
    -2 => ed25519-public-key
}

ed25519-kty = 1
ed25519-alg = -8
ed25519-curve = 6
ed25519-public-key = bstr .size 32

; ---------------------------------------------------------------------
; ML-DSA-65 COSE_Key
;
;  1 = kty = 7   (AKP)
;  3 = alg = -49 (ML-DSA-65)
; -1 = pub = 1952-byte raw public key
; ---------------------------------------------------------------------

ml-dsa-65-cose-key = {
     1 => ml-dsa-kty,
     3 => ml-dsa-65-alg,
    -1 => ml-dsa-65-public-key
}

ml-dsa-kty = 7
ml-dsa-65-alg = -49
ml-dsa-65-public-key = bstr .size 1952

; =====================================================================
; Authorization Proof
; =====================================================================
;
; 1 = Verification Method ID
; 2 = raw algorithm-specific signature bytes
; =====================================================================

authorization-proof = {
    1 => verification-method-id,
    2 => signature
}

; =====================================================================
; Controller Proof of Possession
; =====================================================================

controller-proof = {
    1 => verification-method-id,
    2 => signature
}

; =====================================================================
; Signature
; =====================================================================
;
; v0.1 semantic sizes:
;   Ed25519   = 64 bytes
;   ML-DSA-65 = 3309 bytes
; =====================================================================

signature = bstr .size (1..65535)

; =====================================================================
; Canonical Identity State v1
; =====================================================================
;
; IdentityState represents the current authoritative state resulting
; from applying a valid OpenIdentity operation.
;
; IdentityState is NOT an operation and contains NO authorization
; proofs, signatures, transport metadata, or registry-specific data.
;
; Map labels:
;   1 = state version
;   2 = identity
;   3 = sequence
;   4 = status
;   5 = controller policy
;   6 = recovery commitment (optional)
;
; StateBytes are the deterministic RFC 8949 CBOR encoding of this map.
; =====================================================================

identity-state = {
    1 => identity-state-version,
    2 => identity-id,
    3 => state-sequence,
    4 => identity-status,
    5 => controller-policy,
    ? 6 => recovery-commitment
}

identity-state-version = 1
state-sequence = 1..18446744073709551615

; ---------------------------------------------------------------------
; Identity Status
;
; 1 = ACTIVE
; 2 = DEACTIVATED
; ---------------------------------------------------------------------

identity-status =
      active-status
    / deactivated-status

active-status = 1
deactivated-status = 2

; =====================================================================
; State Hash
; =====================================================================
;
; OpenIdentity v0.1 state hash calculation:
;
;   StateBytes =
;       deterministicCBOR(identity-state)
;
;   digest =
;       SHA-256(StateBytes)
;
;   StateHash =
;       0x12 || 0x20 || digest
;
; where:
;   0x12 = Multihash SHA2-256 code
;   0x20 = 32-byte digest length
;
; StateHash is therefore 34 bytes for the v0.1 SHA2-256 profile.
;
; A subsequent operation places StateHash into previousStateHash.
; =====================================================================

; =====================================================================
; Authorization Signing Structure
; =====================================================================
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Operation",
;   1,
;   operationBytes
; ]
; =====================================================================

operation-signing-structure = [
    "OpenIdentity Operation",
    signing-structure-version,
    operation-bytes
]

; =====================================================================
; Controller Proof-of-Possession Signing Structure
; =====================================================================
;
; Sign deterministic CBOR encoding of:
;
; [
;   "OpenIdentity Controller Proof",
;   1,
;   operationBytes,
;   verificationMethodId
; ]
; =====================================================================

controller-proof-signing-structure = [
    "OpenIdentity Controller Proof",
    signing-structure-version,
    operation-bytes,
    verification-method-id
]

signing-structure-version = 1

; =====================================================================
; Operation Bytes
; =====================================================================
;
; Complete deterministic RFC 8949 CBOR encoding of exactly one valid
; OpenIdentity Operation. It excludes authorization proofs and
; transport metadata.
; =====================================================================

operation-bytes = bstr

; =====================================================================
; Canonical Ordering Requirements
; =====================================================================
;
; VerificationMethods MUST be sorted by Verification Method ID using
; unsigned bytewise lexicographic ordering.
;
; Authorization proofs and controller proofs MUST use the same ordering.
;
; Duplicate Verification Method IDs MUST be rejected within each
; relevant collection.
; =====================================================================

; =====================================================================
; Deterministic CBOR Requirements
; =====================================================================
;
; Every cryptographically authoritative structure MUST use RFC 8949
; Core Deterministic Encoding Requirements.
;
; OpenIdentity v0.1 additionally requires:
;
; - definite-length byte/text strings, arrays, and maps
; - preferred integer serialization
; - deterministic map-key ordering
; - rejection of duplicate map keys
; - rejection of unknown OpenIdentity-defined map labels
; - no floating-point values
; - no NaN or Infinity
; - no undefined
; - no arbitrary CBOR tags
; - no unassigned simple values
;
; Negative integers are permitted where explicitly required by
; standardized COSE structures and identifiers.
; =====================================================================

; =====================================================================
; CREATE State Transition
; =====================================================================
;
; A valid CREATE produces:
;
; {
;   1: 1,                    stateVersion
;   2: identity,
;   3: 1,                    sequence
;   4: 1,                    ACTIVE
;   5: controllerPolicy,
;   6: recoveryCommitment?   if supplied by CREATE
; }
;
; The resulting deterministic CBOR bytes are StateBytes.
; =====================================================================

; =====================================================================
; ROTATE_CONTROLLER State Transition
; =====================================================================
;
; A valid ROTATE_CONTROLLER:
;
; - MUST use previousStateHash equal to the StateHash of the current
;   authoritative IdentityState
; - MUST use sequence = current state sequence + 1
; - MUST be authorized by the CURRENT controller policy
; - MUST include, in signed-operation field 3, valid proof of possession
;   for every proposed new VerificationMethod
;
; Applying it produces a new ACTIVE IdentityState containing the new
; controller policy and incremented sequence.
; =====================================================================

; =====================================================================
; DEACTIVATE State Transition
; =====================================================================
;
; A valid DEACTIVATE uses the current StateHash as previousStateHash
; and produces an IdentityState whose status is DEACTIVATED.
;
; Final permanence and recovery semantics are defined separately.
; =====================================================================

; =====================================================================
; RECOVER Reservation
; =====================================================================
;
; Operation code 3 is allocated to RECOVER but intentionally absent
; from the `operation` choice.
;
; A conforming implementation of this schema MUST reject operationType 3
; until recovery payload, policy, threshold, timing, cryptographic
; diversity, and authorization semantics are normatively defined.
; =====================================================================

; =====================================================================
; End OpenIdentity Operation Wire Format v1
; =====================================================================
